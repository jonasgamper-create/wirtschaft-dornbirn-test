{
  "name": "wirtschaft-dornbirn-test",
  "version": "1.0.0",
  "private": true,
  "description": "Interaktiver Konzeptprototyp für die Wirtschaft Dornbirn",
  "scripts": {
    "build:motion": "esbuild src/motion-enhancements.js --bundle --minify --format=iife --target=es2020 --outfile=site/motion-enhancements.js",
    "build": "npm run build:motion",
    "build:public": "node scripts/build-public.mjs",
    "check:event-data": "node scripts/check-event-data.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:optimization": "node scripts/check-optimization-contract.mjs",
    "check:public": "node scripts/check-public-build.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:interactions": "node scripts/check-interactions.mjs",
    "ci": "npm run build && npm run check:event-data && npm run check:copy && npm run check:optimization && npm run build:public && npm run check:public && npm run check:privacy && npm run check:interactions",
    "report:decision": "bash scripts/run_pdf_tool.sh scripts/build-decision-pdf.py",
    "report:performance": "bash scripts/run_pdf_tool.sh scripts/build_performance_audit_pdf.py",
    "qa:performance-pdf": "bash scripts/run_pdf_tool.sh scripts/qa_performance_audit_pdf.py",
    "social:canva": "node scripts/build-social-canva-drafts.mjs",
    "social:story": "node scripts/build-genussroute-story.mjs"
  },
  "dependencies": {
    "motion": "^12.42.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
