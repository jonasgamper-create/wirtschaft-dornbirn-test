{
  // Reservierungsdienst der Wirtschaft Dornbirn.
  // Der Tischplan im Haus laeuft ohne diesen Dienst weiter; er ergaenzt nur
  // das, was eine statische Seite nicht kann: gemeinsamen Zustand.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wirtschaft-reservierung",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  // Montag frueh die Wochenkarte an die Abonnenten - aber nur, wenn seit dem
  // letzten Versand eine neue Karte hochgeladen wurde. Zwei UTC-Zeitplaene
  // decken Sommer- und Winterzeit ab; im Code entscheidet die Ortszeit
  // (07:15 in Dornbirn), welcher der beiden wirklich feuert.
  // Zwei Aufgaben, zwei Zeitfenster. Die beiden Montagstermine sind die
  // Wochenkarte (07:15 Wiener Zeit, im Winter wie im Sommer - deshalb zwei).
  //
  // Die Viertelstunden-Laeufe sind die Tischerinnerungen. Sie decken 08:00
  // bis 12:45 UTC ab, also 10:00 bis 14:45 Wiener Sommerzeit - eine Stunde
  // vor der ersten Reservierung (11:30) bis nach der letzten (13:30), mit
  // Rand fuer die Winterzeit. Nur Montag bis Freitag: an Wochenenden gibt es
  // keinen Mittagstisch, und ein Lauf, der nichts tun kann, ist Verschwendung.
  // Fuenf Zeitplaene (mehr erlaubt die Gratis-Stufe nicht): Wochenkarte
  // Montag frueh, Erinnerungsfenster am Vormittag, Tageszettel werktags
  // 08:00 Hauszeit (beide moeglichen UTC-Stunden, die Hausuhr entscheidet),
  // Wochenbericht Freitag 15:00 Hauszeit.
  "triggers": { "crons": ["15 5 * * 1", "15 6 * * 1", "*/15 8-12 * * 1-5", "0 6,7 * * 1-5", "0 13,14 * * 5"] },

  "durable_objects": {
    "bindings": [{ "name": "HAUS", "class_name": "Haus" }]
  },
  // SQLite-gestuetzt: die Reservierungen liegen in einer echten Tabelle, nicht
  // in einem einzelnen Schluessel mit Groessengrenze.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Haus"] }],

  "vars": {
    // Nur diese Herkuenfte duerfen den Dienst im Browser ansprechen.
    // Beim eigenen Domainnamen hier ergaenzen.
    "ALLOWED_ORIGINS": "https://jonasgamper-create.github.io,http://localhost:4321,http://localhost:4322,http://localhost:4323",

    // Die eigene Adresse fuer Links in automatisch versendeten Mails - der
    // Wochenkarten-Versand hat keine Anfrage, aus der er sie lesen koennte.
    "DIENST_BASIS": "https://wirtschaft-reservierung.jonas-gamper.workers.dev",

    // Offener Betrieb: die interne Planung verlangt keinen Hausschluessel.
    // Jeder, der die Adresse kennt, sieht die Reservierungen mit Namen und
    // kann einteilen. Bewusste Entscheidung fuer diese Etappe - Bedienbarkeit
    // zuerst, Absicherung als naechster Schritt.
    //
    // Zum Zusperren: auf "nein" stellen, `npx wrangler deploy`, danach
    // `bash schluessel.sh`. Der Hausschluessel gilt dann wieder.
    "OFFEN": "nein",
    // Der oeffentliche Teil des Push-Ausweises. Er ist kein Geheimnis:
    // er steht ohnehin in jeder Seite, die sich anmeldet. Der private
    // Teil liegt als Geheimnis daneben (VAPID_PRIVAT).
    "VAPID_OEFFENTLICH": "BPLEbe0YGZChaS1PY-NtqMLW32AC_PVQ2QTDAYhwnqd6iyQ9V28etINQVmUloVHlLgwQPtiUwCjwnSCtlnvPQTw",
    // Adresse, unter der der Push-Dienst den Absender erreicht, wenn
    // etwas schiefgeht. RFC 8292 verlangt sie.
    "VAPID_KONTAKT": "mailto:willkommen@wirtschaft-dornbirn.at",
    // Wohin Tageszettel und Wochenbericht gehen. In der Testumgebung an
    // Jonas; im echten Betrieb die Adresse des Wirts.
    "WIRT_MAIL": "jonas.gamper@aon.at",
    // Die Gaesteseite - fuer Links in Mails (Warteliste).
    "GAESTE_SEITE": "https://jonasgamper-create.github.io/wirtschaft-dornbirn-test"
  },

  // HAUS_TOKEN ist ein Geheimnis und steht nicht in dieser Datei:
  //   npx wrangler secret put HAUS_TOKEN
  //
  // Ebenso der Mailversand. Beides setzt Wolfgang bzw. der Betreiber selbst;
  // der Schluessel darf nie in einer Datei dieses Verzeichnisses landen:
  //   npx wrangler secret put BREVO_KEY        (API-Schluessel aus dem Brevo-Konto)
  //   npx wrangler secret put BREVO_ABSENDER   (verifizierte Absenderadresse)
  //
  // Fehlt eines von beiden, wird schlicht nichts versendet. Reservierung,
  // Zuteilung und Kalendereintrag im Browser laufen unveraendert weiter -
  // der Mailversand ist eine Zugabe, nie eine Voraussetzung.
  //
  // Kein "keep_vars": es hielt zwar die Variablen, band das Geheimnis aber
  // nicht an die veroeffentlichte Fassung - HAUS_TOKEN fehlte in der
  // Bindungsliste und kam im Code als leer an.
}
